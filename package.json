{
  "name": "opsyn-platform",
  "version": "1.0.0",
  "description": "Opsyn - AI-Powered Energy Operations Platform",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "install:all": "npm install --legacy-peer-deps",
    "api": "node server.js",
    "customer": "npm run --workspace=@opsyn/customer start",
    "driver": "npm run --workspace=@opsyn/driver start",
    "operations": "npm run --workspace=@opsyn/operations start",
    "customer:tunnel": "npm run --workspace=@opsyn/customer start -- --tunnel",
    "driver:tunnel": "npm run --workspace=@opsyn/driver start -- --tunnel",
    "operations:tunnel": "npm run --workspace=@opsyn/operations start -- --tunnel",
    "customer:android": "npm run --workspace=@opsyn/customer android",
    "driver:android": "npm run --workspace=@opsyn/driver android",
    "operations:android": "npm run --workspace=@opsyn/operations android",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.0.2",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.9.26",
    "@tanstack/react-query": "^5.45.0",
    "cors": "^2.8.5",
    "expo": "~51.0.38",
    "expo-status-bar": "~1.12.1",
    "express": "^4.19.2",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1"
  },
  "devDependencies": {
    "typescript": "~5.3.3",
    "vitest": "^1.6.0"
  }
}
