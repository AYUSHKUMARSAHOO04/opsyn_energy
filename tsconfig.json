{
  "compilerOptions": {
    "target": "ESNext",
    "module": "CommonJS",
    "lib": ["DOM", "ESNext"],
    "jsx": "react-native",
    "strict": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@opsyn/shared": ["packages/shared/src/index.ts"],
      "@opsyn/shared/*": ["packages/shared/src/*"]
    }
  },
  "exclude": ["node_modules"]
}
